# Copiar a hsm-service.env (gitignored). Genera hsm-service-env vía
# scripts/apply-service-env-secrets.sh hsm-service.
#
# HSM_PIN y la master key NO van acá -- vienen de
# k8s/shared-secrets/hsm-secrets.secret.yaml. AUDIT_API_KEY tampoco -- ver
# k8s/service-keys/.

HSM_LIBRARY_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_TOKEN_LABEL=digsigna-token
HSM_AUTH_PUBLIC_KEY_PATH=/etc/hsm/certs/public.pem
HSM_AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
HSM_AUDIT_HTTP_BASE_URL=http://audit-service:8080
