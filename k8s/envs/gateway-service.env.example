# Copiar a gateway-service.env (gitignored). Genera gateway-service-env
# vía scripts/apply-service-env-secrets.sh gateway-service. AUDIT_API_KEY
# vive aparte en k8s/service-keys/.
#
# GATEWAY_REDIS_ADDRESS: no fijar esto hasta tener un Redis real
# desplegado (ver nota en gateway-service.secret.yaml) -- dejarlo vacío
# hace que /ready pase trivialmente sin validar nada, lo cual es peor que
# no tener el check, pero es el comportamiento actual confirmado si no se
# configura.

GATEWAY_AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
GATEWAY_REDIS_ADDRESS=
GATEWAY_AUDIT_HTTP_BASE_URL=http://audit-service:8080
