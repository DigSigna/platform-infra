# Copiar a gateway-service.env (gitignored). Genera gateway-service-env
# vía scripts/apply-service-env-secrets.sh gateway-service. AUDIT_API_KEY
# vive aparte en k8s/service-keys/.
#
# GATEWAY_REDIS_ADDRESS: ahora apunta al Redis desplegado en
# k8s/deployments/redis-gateway.yaml (Service "redis", namespace digsigna).
# Sin AUTH/password -- confirmado así en todos los entornos (ver
# docs/env-vars-inventory.md).
#
# GATEWAY_CONFIG_PATH/GATEWAY_ENVIRONMENT: ver nota en
# gateway-service.secret.yaml -- requiere el ConfigMap
# k8s/configmaps/gateway-service-config.yaml montado en esa ruta.

GATEWAY_ENVIRONMENT=production
GATEWAY_CONFIG_PATH=/etc/gateway-service/config.yaml
GATEWAY_AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
GATEWAY_REDIS_ADDRESS=redis:6379
GATEWAY_AUDIT_HTTP_BASE_URL=http://audit-service:8080
