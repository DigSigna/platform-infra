# Copiar a signing-service.env (gitignored). Genera signing-service-env
# vía scripts/apply-service-env-secrets.sh signing-service. AUDIT_API_KEY
# vive aparte en k8s/service-keys/.

DB_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:3306/digsigna
HSM_SERVICE_BASE_URL=http://hsm-service:8080
CERTIFICATE_SERVICE_BASE_URL=http://certificate-service:8000
AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
AUDIT_HTTP_BASE_URL=http://audit-service:8080
# GET /health depende de esto incondicionalmente (no solo si
# AUTH_TOKEN_CACHE_ENABLED=true) -- ver nota en signing-service.secret.yaml.
# Resuelto: reusa el Redis de k8s/deployments/redis-gateway.yaml (Service
# "redis") -- este servicio solo hace PING, nunca escribe ninguna key, así
# que compartirlo con api-gateway/verification-service no tiene riesgo de
# colisión real.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# TSA_PRIMARY_URL / TSA_SECONDARY_URL son servicios públicos sin
# credenciales (freetsa.org, time.certum.pl) -- no necesitan Secret, van en
# un ConfigMap o el default del propio código si se decide no fijarlos.
