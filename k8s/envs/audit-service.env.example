# Copiar a audit-service.env (gitignored). Genera audit-service-env vía
# scripts/apply-service-env-secrets.sh audit-service.
#
# Las 6 AUDIT_KEY_<SERVICIO> van en k8s/service-keys/audit-service.secret.yaml,
# no acá -- son un mecanismo separado (validación de productores, no config
# general del servicio).

DATABASE_URL=digsigna:REPLACE_PASSWORD@tcp(REPLACE_HOST:3306)/digsigna?parseTime=true&tls=skip-verify
AUDIT_AUTH_PUBLIC_KEY_PATH=/app/certs/public.pem
AUDIT_AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
