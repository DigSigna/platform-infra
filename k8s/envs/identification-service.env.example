# Copiar a identification-service.env (gitignored) con valores reales.
# Genera el Secret identification-service-env vía
# scripts/apply-service-env-secrets.sh identification-service
# (kubectl create secret generic --from-env-file=, idempotente).
#
# No incluye AUDIT_API_KEY (ver k8s/service-keys/). NO incluye
# JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH a propósito -- su sola presencia
# desactiva la rotación real de llaves (ver JWT_SIGNING_KEYS_DIR abajo y
# k8s/storage/identification-service-jwt-keys-pvc.yaml).

DB_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@tcp(REPLACE_HOST:3306)/digsigna?parseTime=true
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_USER=REPLACE_KEYCLOAK_ADMIN_USER
KEYCLOAK_ADMIN_PASSWORD=REPLACE_KEYCLOAK_ADMIN_PASSWORD
BOOTSTRAP_SECRET=REPLACE_BOOTSTRAP_SECRET
HSM_SERVICE_URL=http://hsm-service:8080
CERTIFICATE_SERVICE_URL=http://certificate-service:8000
AUDIT_SERVICE_URL=http://audit-service:8080
REDIS_URL=
ALLOWED_ORIGINS=
JWT_ISSUER=identification-service
JWT_SIGNING_KEYS_DIR=/var/lib/identification-service/jwt-keys
