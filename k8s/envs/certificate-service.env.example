# Copiar a certificate-service.env (gitignored). Genera
# certificate-service-env vía scripts/apply-service-env-secrets.sh
# certificate-service. AUDIT_API_KEY vive aparte en k8s/service-keys/.

DB_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:3306/digsigna
HSM_SERVICE_BASE_URL=http://hsm-service:8080
IDENTITY_SERVICE_BASE_URL=http://identification-service:3000
AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
AUTH_ISSUER=identification-service
AUTH_AUDIENCE=certificate-service
AUDIT_HTTP_BASE_URL=http://audit-service:8080
# Resuelto: reusa el Redis de k8s/deployments/redis-gateway.yaml (Service
# "redis") -- este servicio solo hace PING, nunca escribe ninguna key, así
# que compartirlo con signing-service/verification-service no tiene riesgo
# de colisión real. Hay que fijarlo a mano (no alcanza con el default de
# app/core/config.py) porque el kubelet inyecta su propia env var
# REDIS_PORT="tcp://<ip>:6379" para el Service "redis" en todo pod del
# namespace, y sin un REDIS_PORT explícito acá esa inyección automática
# gana y rompe Settings() (int_parsing).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
