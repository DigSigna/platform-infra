# Copiar a verification-service.env (gitignored). Genera
# verification-service-env vía scripts/apply-service-env-secrets.sh
# verification-service. AUDIT_API_KEY vive aparte en k8s/service-keys/.

DB_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:3306/digsigna
CERTIFICATE_SERVICE_BASE_URL=http://certificate-service:8000
AUTH_JWKS_URL=http://identification-service:3000/.well-known/jwks.json
AUDIT_HTTP_BASE_URL=http://audit-service:8080
# GET /api/v1/health depende de esto incondicionalmente -- ver nota en
# verification-service.secret.yaml. Reusa el Redis de
# k8s/deployments/redis-gateway.yaml (Service "redis").
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
